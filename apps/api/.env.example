# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URL of the frontend (used for OAuth redirects and CORS)
WEB_URL=http://localhost:3000
# Public URL of this API (used to build the Zoho OAuth redirect URI)
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://brainwave:brainwave@localhost:5432/brainwave

# Auth. Generate secrets with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30

# 32-byte key, base64 encoded, used to encrypt Zoho OAuth tokens at rest
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change-me-32-bytes-base64

# Zoho. Create a "Server-based Applications" client at https://api-console.zoho.in
# Authorized redirect URI must be: ${API_URL}/api/zoho/oauth/callback
ZOHO_REGION=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Optional. If left empty the API discovers the first organization on the account.
ZOHO_DESK_ORG_ID=
ZOHO_BOOKS_ORG_ID=
# Serve fixture data instead of calling Zoho. Handy before credentials exist.
ZOHO_MOCK=true
# Seconds to cache Zoho records per service (0 disables). Protects the service account's API quota.
ZOHO_CACHE_TTL_SECONDS=60

# Deployment
# Reverse proxies in front of the API: 1 for Render alone, 2 when a Vercel rewrite sits in front of Render.
TRUST_PROXY=1
# Public demo hardening: seeded accounts cannot be deleted, deactivated, re-roled or given a new
# password; seeded roles cannot be deleted; the Zoho connection cannot be removed or replaced.
DEMO_MODE=false
